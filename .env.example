# FLASH environment variables.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Only values the browser needs are prefixed NEXT_PUBLIC_.

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server only, never NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Groq (server only, never NEXT_PUBLIC_)
GROQ_API_KEY=

# OpenRouter backup for chat failover (server only, never NEXT_PUBLIC_).
# Free, no card. Optional: without it, a failed Groq call simply fails
# honestly instead of retrying on the backup.
OPENROUTER_API_KEY=

# ElevenLabs speech-to-text (server only, never NEXT_PUBLIC_)
ELEVENLABS_API_KEY=

# Tavily web search (server only, never NEXT_PUBLIC_)
TAVILY_API_KEY=

# Voyage AI embeddings for vector memory RAG (server only, never NEXT_PUBLIC_).
# Free: first 200M tokens per account on voyage-4-lite (2026-11-25).
# Create the key at dashboard.voyageai.com (API Keys) — use a dashboard
# key (prefix pa-). Optional: without it, memories and documents stay
# unembedded and chat falls back to keyword/recency retrieval.
VOYAGE_API_KEY=

# Daily model-call cap (default 1000 — Groq llama-3.3-70b-versatile free tier). Bad value fails closed to 0.
DAILY_MODEL_CALL_CAP=

# Daily web-search cap (default 10).
DAILY_SEARCH_CAP=

# Telegram bot (server only, never NEXT_PUBLIC_). Setup: docs/TELEGRAM.md.
# TELEGRAM_BOT_TOKEN — from @BotFather in Telegram (never share it).
# TELEGRAM_USER_ID — your numeric Telegram user id (message @userinfobot,
#   it replies with your id). Only this id can use the bot.
# TELEGRAM_WEBHOOK_SECRET — any random string you invent; Telegram sends
#   it back on every webhook call and the server rejects calls without it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# Proactive-check auth (server only). Vercel sets CRON_SECRET automatically
# for Cron jobs; TELEGRAM_PROACTIVE_SECRET is the manual equivalent for a
# scheduled call from anywhere else. When neither is set, the proactive
# route refuses every call.
TELEGRAM_PROACTIVE_SECRET=

# Test guard: must be exactly "dev" for database tests to run.
APP_ENV=
